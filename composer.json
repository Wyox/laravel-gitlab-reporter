{
    "name": "wyox/laravel-gitlab-reporter",
    "description": "Creates Gitlab Issues when Exceptions are thrown",
    "type": "library",
    "keywords": [
        "gitlab",
        "error reporting"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12|^13",
        "illuminate/http": "^12|^13",
        "illuminate/support": "^12|^13",
        "m4tthumphrey/php-gitlab-api": "^12.1",
        "guzzlehttp/guzzle": "^7.15.2|^8.0.1",
        "guzzlehttp/psr7": "^2.12.3|^3.0",
        "symfony/var-dumper": "^7.2|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "mockery/mockery": "^1.6"
    },
    "authors": [
        {
            "name": "Ivo de Bruijn",
            "email": "ik@ivodebruijn.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "Wyox\\GitlabReport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wyox\\GitlabReport\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wyox\\GitlabReport\\ServiceProvider"
            ],
            "aliases": {
                "GitlabReport": "Wyox\\GitlabReport\\Facade"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
